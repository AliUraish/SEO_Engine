# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Neon: paste the connection string from the Neon console (Dashboard → Connect) as-is, e.g.
# DATABASE_URL=postgresql://neondb_owner:***@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# (sslmode/channel_binding are translated for asyncpg automatically; the -pooler host is fine.)
# Leave as SQLite for zero-setup local dev.
DATABASE_URL=sqlite+aiosqlite:///./data/rankos.db

# --- Master network switch ---
# Nothing leaves this machine (no crawling, no Google, no GitHub, no OpenAI)
# until this is "true". Each integration additionally needs its own credentials.
NETWORK_ENABLED=false

# --- Crawler ---
CRAWL_USER_AGENT=RankOSBot/0.1 (+https://rankos.local)
CRAWL_CONCURRENCY=4
CRAWL_MAX_PAGES=500
CRAWL_TIMEOUT_S=15

# --- OpenAI (Fixer copy / Keyword Scout strategy / Migration Advisor narrative) ---
OPENAI_API_KEY=
OPENAI_MODEL=sol
# Change this for an OpenAI-compatible proxy or gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
# Set true only if OPENAI_MODEL is a reasoning model (enables reasoning effort per call).
OPENAI_REASONING=false

# --- Google Search Console ---
# Service-account JSON: a file path or the inline JSON. The SA email must be a user on the GSC property.
GSC_SERVICE_ACCOUNT_JSON=

# --- GitHub (PR adapter) ---
GITHUB_TOKEN=
# Local checkout of the site's repo that RankOS may branch/commit in.
REPO_LOCAL_PATH=

# --- Worker ---
WORKER_ENABLED=true
WORKER_POLL_S=1.5
WORKER_CONCURRENCY=2
