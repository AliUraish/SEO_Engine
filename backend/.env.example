# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Default: zero-setup SQLite at ./data/rankos.db. For Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/rankos
DATABASE_URL=sqlite+aiosqlite:///./data/rankos.db

# --- Master network switch ---
# Nothing leaves this machine (no crawling, no Google, no GitHub, no OpenAI)
# until this is "true". Each integration additionally needs its own credentials.
NETWORK_ENABLED=false

# --- Crawler ---
CRAWL_USER_AGENT=RankOSBot/0.1 (+https://rankos.local)
CRAWL_CONCURRENCY=4
CRAWL_MAX_PAGES=500
CRAWL_TIMEOUT_S=15

# --- OpenAI (Fixer copy / Keyword Scout strategy / Migration Advisor narrative) ---
OPENAI_API_KEY=
OPENAI_MODEL=sol
# Optional: custom endpoint (Azure/proxy). Leave empty for api.openai.com.
OPENAI_BASE_URL=
# Set true only if OPENAI_MODEL is a reasoning model (enables reasoning effort per call).
OPENAI_REASONING=false

# --- Google Search Console ---
# Service-account JSON: a file path or the inline JSON. The SA email must be a user on the GSC property.
GSC_SERVICE_ACCOUNT_JSON=

# --- GitHub (PR adapter) ---
GITHUB_TOKEN=
# Local checkout of the site's repo that RankOS may branch/commit in.
REPO_LOCAL_PATH=

# --- Worker ---
WORKER_ENABLED=true
WORKER_POLL_S=1.5
WORKER_CONCURRENCY=2
